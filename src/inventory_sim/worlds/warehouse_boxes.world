<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="warehouse_boxes">

    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.95 0.95 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- floor -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>12 12 0.1</size></box>
          </geometry>
          <pose>0 0 -0.05 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>12 12 0.1</size></box>
          </geometry>
          <pose>0 0 -0.05 0 0 0</pose>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- surrounding walls -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 5.9 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.9 1</ambient>
            <diffuse>0.85 0.85 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>0 -5.9 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.9 1</ambient>
            <diffuse>0.85 0.85 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>5.9 0 0.75 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.9 1</ambient>
            <diffuse>0.85 0.85 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-5.9 0 0.75 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.9 1</ambient>
            <diffuse>0.85 0.85 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- randomly placed boxes -->
    <model name="box_1">
      <static>true</static>
      <pose>2.2 2.0 0.4 0 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 0.8 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.8</size></box></geometry>
          <material>
            <ambient>0.6 0.3 0.3 1</ambient>
            <diffuse>0.6 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_2">
      <static>true</static>
      <pose>-2.7 1.4 0.5 0 0 0.8</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.6 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.6 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.5 0.7 1</ambient>
            <diffuse>0.3 0.5 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_3">
      <static>true</static>
      <pose>0.0 -2.3 0.35 0 0 0.2</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.7 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.7 0.7</size></box></geometry>
          <material>
            <ambient>0.4 0.7 0.4 1</ambient>
            <diffuse>0.4 0.7 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_4">
      <static>true</static>
      <pose>3.5 -1.2 0.45 0 0 1.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.9 0.9 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.9 0.9 0.9</size></box></geometry>
          <material>
            <ambient>0.7 0.6 0.3 1</ambient>
            <diffuse>0.7 0.6 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_5">
      <static>true</static>
      <pose>-1.0 -3.6 0.4 0 0 0.5</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 1.0 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 1.0 0.8</size></box></geometry>
          <material>
            <ambient>0.5 0.4 0.7 1</ambient>
            <diffuse>0.5 0.4 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

